# Секреты Shio. Скопируйте этот файл в .env (cp .env.example .env) и впишите значения.
# Файл .env не попадает в git и в образ Docker. Никому его не пересылайте.

# Токен Telegram-бота от @BotFather (пусто — Telegram выключен, уведомления только в журнал)
SHIO_TELEGRAM_TOKEN=

# Ключ шифрования резервных копий базы: 32 байта в base64.
# Создать: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Сохраните ключ отдельно: без него копию не восстановить.
SHIO_BACKUP_KEY=

# Адрес проверки healthchecks.io (https://hc-ping.com/...); пусто — сторож выключен
SHIO_HEALTHCHECK_URL=
